# SPDX-License-Identifier: MIT
# Build environment for Linux releases of Ferrum (used by scripts/build-linux.sh).
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      clang llvm libclang-dev lld cmake python3 pkg-config curl git \
      libfontconfig-dev libfreetype-dev libharfbuzz-dev \
      libx11-dev libxcb1-dev libxcursor-dev libxrandr-dev libxi-dev \
      libxkbcommon-dev libxkbcommon-x11-dev libwayland-dev \
      libegl-dev libgl-dev libgles-dev libssl-dev libdbus-1-dev libudev-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*
